# Settings read by app/build.py. Set them as environment variables before building.
# Never commit real values. Without them the build uses placeholders and only ?demo=1 works.

# Firebase console -> Project settings -> Your apps
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Address of your own copy of ocr-worker
OCR_URL=https://ocr.example.com/

# ocr-worker: set as a Secret in Cloudflare, not here
# GEMINI_API_KEY=your-gemini-api-key
